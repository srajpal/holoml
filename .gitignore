# Dependencies and build output
node_modules/
dist/
out/
build/
release/
.turbo/
.cache/
*.tsbuildinfo

# Environment and secrets: never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Test and coverage artefacts
coverage/
playwright-report/
test-results/

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Local browser profile data created while developing
userData/

# Owner-only Claude Code automation; recreate from HANDOFF.md on a new machine
CLAUDE.local.md

# Downloads for the example sites' tools (made again by their download scripts)
examples/*/tools/cache/

# The site, made by pnpm site:build
_site/
