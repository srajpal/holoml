<holoml version="0.1">
  <head>
    <title>The red car (example)</title>
  </head>
  <scene background="#10131f">
    <viewpoint position="0 1.7 6" look-at="0 0.8 0" mode="walk" />
    <light type="ambient" intensity="0.4" />
    <light type="directional" position="4 8 5" intensity="1.2" />
    <model src="models/placeholder-car.gltf">
      <material name="Paint" color="#c0182a" metalness="0.7" roughness="0.3" />
      <material name="Glass" opacity="0.35" />
    </model>
    <a href="index.holoml">
      <label position="0 2.4 -3" size="0.25">Back to the showroom</label>
    </a>
  </scene>
</holoml>
