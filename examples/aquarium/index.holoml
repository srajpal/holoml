<holoml version="0.3">
  <head>
    <title>Ocean tunnel</title>
    <meta name="description" content="An aquarium to walk through: a glass tunnel under a big tank, where sharks, a sea turtle, tuna, and schools of fish swim over and around you. Feed them, and click a fish to read about it. A HoloML 0.3 site." />
    <meta name="author" content="The HoloML Authors" />
    <script src="aquarium.js" />
  </head>
  <!-- A tank 24 m wide, 34 m long, and 6.5 m deep, with a glass tunnel
       along its floor from the gallery at its front to near its back. The
       water fills the tank (the tunnel's air counts as water: seen from
       inside, the near glass and the walkway take a little of its blue). -->
  <scene background="#0b2c3d">
    <viewpoint id="entrance" mode="walk" position="0 1.6 18.4" look-at="0 1.5 8" label="The entrance" />
    <viewpoint id="tunnel" mode="walk" position="0 1.6 5" look-at="0 2.8 -3" label="In the tunnel" />
    <viewpoint id="feeding" mode="walk" position="-0.6 1.6 1.5" look-at="3.6 3 0" label="The feeding place" />
    <viewpoint id="end" mode="walk" position="0 1.6 -10.4" look-at="0 1.8 -15" label="The end of the tunnel" />

    <light type="ambient" intensity="0.55" color="#a4cfdc" />
    <light id="sun" type="directional" position="3 22 6" look-at="0 0 0" intensity="1.35" color="#eef8ff" shadows />
    <light type="point" position="0 3.1 17" intensity="1.2" range="9" color="#ffe9cf" />
    <water position="0 -0.3 -3" size="24 6.8 34" color="#1d5f7c" clarity="16" caustics />
    <sound id="water" src="sounds/water.wav" volume="0.3" loop autoplay />

    <!-- The gallery: the way in, out of the water. -->
    <model src="models/gallery.glb" />
    <model src="models/wall.glb" position="0 0 20.15" scale="10.6 3.4 0.3" solid />
    <model src="models/wall.glb" position="-5.15 0 17" scale="0.3 3.4 6.3" solid />
    <model src="models/wall.glb" position="5.15 0 17" scale="0.3 3.4 6.3" solid />
    <model src="models/wall.glb" position="-3.85 0 13.85" scale="2.3 3.4 0.3" solid />
    <model src="models/wall.glb" position="3.85 0 13.85" scale="2.3 3.4 0.3" solid />
    <panel position="-4.98 1.75 16.8" rotation="0 90 0" width="1.5" size="0.055" color="#e8f4f8" background="#12303f">
      The ocean tunnel

      Walk through the glass tunnel under the tank, and the fish swim over and around you: sharks, a sea turtle, tuna, and schools of smaller fish.

      Feed them at the middle of the tunnel (the Feed button, or F). Click a fish, or choose it in the list, to read about it on the board there.
    </panel>
    <a href="about.holoml">
      <panel position="4.98 1.6 16.8" rotation="0 -90 0" width="0.9" size="0.06" color="#ffffff" background="#1d6fa5">About the aquarium</panel>
    </a>

    <!-- The tank, its sand, rocks, and plants. -->
    <model src="models/tank.glb" />
    <group shadows>
      <model src="models/sand.glb" />
      <!-- prepare.mjs: the tank (made from ocean.js: edit there, and run tools/prepare.mjs) -->
      <model src="models/boulder.glb" position="-4.6 0 7" rotation="0 30 0" scale="1.1" />
      <model src="models/boulder.glb" position="5.8 0 3.5" rotation="0 150 0" scale="1.6" />
      <model src="models/boulder.glb" position="-6.4 0 -5.5" rotation="0 80 0" scale="2.1" />
      <model src="models/boulder.glb" position="4.6 0 -8.5" rotation="0 210 0" scale="1.3" />
      <model src="models/boulder.glb" position="0.5 0 -14.2" rotation="0 10 0" scale="2.6" />
      <model src="models/boulder.glb" position="-3.5 0 -1.2" rotation="0 300 0" scale="0.7" />
      <model src="models/boulder.glb" position="7.2 0 10.5" rotation="0 45 0" scale="1.8" />
      <model src="models/boulder.glb" position="-7.4 0 11.5" rotation="0 120 0" scale="1.4" />
      <model src="models/boulder.glb" position="-11.3 -0.6 -15" rotation="0 15 0" scale="3.2" />
      <model src="models/boulder.glb" position="-11.6 -0.8 -5" rotation="0 140 0" scale="3.6" />
      <model src="models/boulder.glb" position="-11.4 -0.6 5" rotation="0 260 0" scale="3" />
      <model src="models/boulder.glb" position="11.4 -0.7 -13" rotation="0 95 0" scale="3.4" />
      <model src="models/boulder.glb" position="11.6 -0.8 -2.5" rotation="0 330 0" scale="3.8" />
      <model src="models/boulder.glb" position="11.3 -0.6 7.5" rotation="0 200 0" scale="3.1" />
      <model src="models/boulder.glb" position="-6 -0.8 -19.6" rotation="0 60 0" scale="3.3" />
      <model src="models/boulder.glb" position="6.5 -0.7 -19.4" rotation="0 170 0" scale="3" />
      <model src="models/log.glb" position="4.4 0.25 8.5" rotation="0 65 0" scale="0.7" />
      <model src="models/shell.glb" position="-3.1 0.03 9.2" rotation="0 20 0" scale="1.4" />
      <model src="models/shell.glb" position="3.3 0.03 -3.6" rotation="0 200 0" scale="1.2" />
      <model src="models/shell.glb" position="-3.4 0.03 -8.4" rotation="0 110 0" scale="1.5" />
      <model src="models/airstone.glb" position="-4.2 0.05 3.5" />
      <model src="models/airstone.glb" position="4.9 0.05 -5.8" />
      <model src="models/airstone.glb" position="-2.9 0.05 -10.5" />
      <model src="models/seagrass-a.glb" position="-3.1 0 -9.5" rotation="0 0 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="3 0 -8.3" rotation="0 0 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="-3.4 0 -6" rotation="0 40 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="3.4 0 -4.8" rotation="0 70 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="-3.7 0 -2.5" rotation="0 80 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="3 0 -1.3" rotation="0 140 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="-3.1 0 1" rotation="0 120 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="3.4 0 2.2" rotation="0 210 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="-3.4 0 4.5" rotation="0 160 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="3 0 5.7" rotation="0 280 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="-3.7 0 8" rotation="0 200 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="3.4 0 9.2" rotation="0 350 0" animation="Sway" autoplay />
      <model src="models/seagrass-a.glb" position="-3.1 0 11.5" rotation="0 240 0" animation="Sway" autoplay />
      <model src="models/seagrass-b.glb" position="3 0 12.7" rotation="0 420 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-10.8 0 -17.5" rotation="0 0 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-10.4 0 -10" rotation="0 53 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-10.9 0 -1" rotation="0 106 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-10.5 0 8.5" rotation="0 159 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-9.6 0 12.8" rotation="0 212 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="10.8 0 -17" rotation="0 265 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="10.5 0 -8" rotation="0 318 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="10.9 0 1.5" rotation="0 371 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="10.4 0 10.5" rotation="0 424 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="9.8 0 12.9" rotation="0 477 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-3.5 0 -19.2" rotation="0 530 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="3.2 0 -19.1" rotation="0 583 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="-7.5 0 -14.5" rotation="0 636 0" animation="Sway" autoplay />
      <model src="models/kelp.glb" position="7.8 0 -15.5" rotation="0 689 0" animation="Sway" autoplay />
      <!-- /prepare.mjs: the tank -->
    </group>
    <!-- prepare.mjs: bubblers -->
    <sound id="bubbler-1" src="sounds/bubbles.wav" position="-4.2 0.35 3.5" range="9" volume="0.8" loop autoplay />
    <sound id="bubbler-2" src="sounds/bubbles.wav" position="4.9 0.35 -5.8" range="9" volume="0.8" loop autoplay />
    <sound id="bubbler-3" src="sounds/bubbles.wav" position="-2.9 0.35 -10.5" range="9" volume="0.8" loop autoplay />
    <!-- /prepare.mjs: bubblers -->

    <!-- The tunnel: ledges along its sides and a rail across its end keep walkers off the glass. -->
    <model src="models/tunnel.glb" />
    <model src="models/ledge.glb" position="-1.95 0 1" solid />
    <model src="models/ledge.glb" position="1.95 0 1" solid />
    <model src="models/rail.glb" position="0 0 -11.6" solid />

    <!-- The board where a fish is told about, and the Feed button, halfway along. -->
    <panel id="board" position="-1.74 1.35 1.8" rotation="0 90 0" width="1.2" size="0.045" color="#1f2328" background="#f4f7f8">
      The fish of the tunnel

      Click a fish, or choose it in the list, to read about it here.
    </panel>
    <panel id="feed" position="1.74 1.2 0.2" rotation="0 -90 0" width="0.6" size="0.07" color="#ffffff" background="#1d6fa5">Feed the fish</panel>
    <sound id="plop" src="sounds/plop.wav" begin="click" trigger="#feed" label="Feed the fish" />
    <hud id="status" corner="bottom-left"></hud>

    <!-- The fish: the page's script swims them. -->
    <group id="fish" shadows>
      <!-- prepare.mjs: the fish (made from ocean.js: edit there, and run tools/prepare.mjs) -->
      <model id="shark-1" src="models/shark.glb" far="models/shark-far.glb" far-from="10" label="Great white shark" position="-10.993 4.165 11.874" rotation="0 289.676 0" animation="Swim" autoplay />
      <model id="shark-2" src="models/shark.glb" far="models/shark-far.glb" far-from="10" label="Great white shark" position="7.556 5.45 10.294" rotation="0 300.043 0" animation="Swim" autoplay />
      <model id="turtle-1" src="models/turtle.glb" far="models/turtle-far.glb" far-from="10" label="Hawksbill sea turtle" position="7.725 3.767 3.931" rotation="0 106.586 0" animation="Swim" autoplay />
      <model id="tuna-1" src="models/tuna.glb" far="models/tuna-far.glb" far-from="10" label="Tuna" position="-9.469 4.052 -12.55" rotation="0 258.375 0" animation="Swim" autoplay />
      <model id="tuna-2" src="models/tuna.glb" far="models/tuna-far.glb" far-from="10" label="Tuna" position="5.292 3.151 -13.612" rotation="0 53.295 0" animation="Swim" autoplay />
      <model id="barramundi-1" src="models/barramundi.glb" far="models/barramundi-far.glb" far-from="10" label="Barramundi" position="-7.746 2.124 0.226" rotation="0 277.402 0" animation="Swim" autoplay />
      <model id="barramundi-2" src="models/barramundi.glb" far="models/barramundi-far.glb" far-from="10" label="Barramundi" position="6.835 0.723 4.713" rotation="0 116.335 0" animation="Swim" autoplay />
      <model id="bream-1" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="-5.497 2.977 10.827" rotation="0 64.569 0" animation="Swim" autoplay />
      <model id="bream-2" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="-0.933 3.439 -18.102" rotation="0 227.712 0" animation="Swim" autoplay />
      <model id="bream-3" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="10.535 1.334 -9.679" rotation="0 226.468 0" animation="Swim" autoplay />
      <model id="bream-4" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="8.527 2.852 11.884" rotation="0 322.928 0" animation="Swim" autoplay />
      <model id="bream-5" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="-4.994 1.471 9.179" rotation="0 153.463 0" animation="Swim" autoplay />
      <model id="bream-6" src="models/bream.glb" far="models/bream-far.glb" far-from="10" label="Gilt-head bream" position="1.914 2.947 -10.093" rotation="0 262.751 0" animation="Swim" autoplay />
      <model id="mackerel-1" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="7.189 5.873 6.421" rotation="0 99.912 0" animation="Swim" autoplay />
      <model id="mackerel-2" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="-0.371 3.818 2.749" rotation="0 60.469 0" animation="Swim" autoplay />
      <model id="mackerel-3" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="-9.232 4.686 -10.656" rotation="0 328.293 0" animation="Swim" autoplay />
      <model id="mackerel-4" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="4.841 5.66 -17.765" rotation="0 190.437 0" animation="Swim" autoplay />
      <model id="mackerel-5" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="5.496 4.465 -4.038" rotation="0 259.072 0" animation="Swim" autoplay />
      <model id="mackerel-6" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="-10.07 4.992 -16.843" rotation="0 79.951 0" animation="Swim" autoplay />
      <model id="mackerel-7" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="1.725 5.857 -14.161" rotation="0 234.207 0" animation="Swim" autoplay />
      <model id="mackerel-8" src="models/mackerel.glb" far="models/mackerel-far.glb" far-from="10" label="Atlantic mackerel" position="-6.013 5.036 6.65" rotation="0 66.674 0" animation="Swim" autoplay />
      <model id="snapper-1" src="models/snapper.glb" far="models/snapper-far.glb" far-from="10" label="Grey snapper" position="5.322 2.553 -5.125" rotation="0 201.956 0" animation="Swim" autoplay />
      <model id="snapper-2" src="models/snapper.glb" far="models/snapper-far.glb" far-from="10" label="Grey snapper" position="-5.816 1.939 9.255" rotation="0 180.697 0" animation="Swim" autoplay />
      <model id="snapper-3" src="models/snapper.glb" far="models/snapper-far.glb" far-from="10" label="Grey snapper" position="-10.076 0.565 -17.587" rotation="0 66.46 0" animation="Swim" autoplay />
      <model id="snapper-4" src="models/snapper.glb" far="models/snapper-far.glb" far-from="10" label="Grey snapper" position="6.066 1.154 -9.122" rotation="0 157.625 0" animation="Swim" autoplay />
      <model id="clownfish-1" src="models/clownfish.glb" far="models/clownfish-far.glb" far-from="10" label="Clownfish" position="8.77 0.826 9.786" rotation="0 157.567 0" animation="Swim" autoplay />
      <model id="clownfish-2" src="models/clownfish.glb" far="models/clownfish-far.glb" far-from="10" label="Clownfish" position="-7.265 1.216 4.376" rotation="0 187.285 0" animation="Swim" autoplay />
      <model id="clownfish-3" src="models/clownfish.glb" far="models/clownfish-far.glb" far-from="10" label="Clownfish" position="4.902 0.764 -7.727" rotation="0 263.017 0" animation="Swim" autoplay />
      <model id="butterflyfish-1" src="models/butterflyfish.glb" far="models/butterflyfish-far.glb" far-from="10" label="Copperband butterflyfish" position="-5.321 0.709 12.067" rotation="0 36.694 0" animation="Swim" autoplay />
      <model id="butterflyfish-2" src="models/butterflyfish.glb" far="models/butterflyfish-far.glb" far-from="10" label="Copperband butterflyfish" position="-8.743 1.271 7.427" rotation="0 150.024 0" animation="Swim" autoplay />
      <sound src="sounds/blip.wav" begin="click" trigger="#shark-1" label="About the great white shark" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#turtle-1" label="About the hawksbill sea turtle" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#tuna-1" label="About the tuna" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#barramundi-1" label="About the barramundi" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#bream-1" label="About the gilt-head bream" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#mackerel-1" label="About the Atlantic mackerel" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#snapper-1" label="About the grey snapper" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#clownfish-1" label="About the clownfish" volume="0.5" />
      <sound src="sounds/blip.wav" begin="click" trigger="#butterflyfish-1" label="About the copperband butterflyfish" volume="0.5" />
      <!-- /prepare.mjs: the fish -->
    </group>
  </scene>
</holoml>
