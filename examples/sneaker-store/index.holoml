    </group>
    <group load="near" near="7.5" position="5 0 -8.5" rotation="0 -90 0" shadows>
      <a href="shoe.holoml?colour=violet">
        <model id="shoe-violet-1" src="models/shoe-violet.glb" stand-in="models/shoe-violet-far.glb" position="-0.95 0.98 0.25" rotation="0 -20 0" />
        <model id="shoe-violet-2" src="models/shoe-violet.glb" stand-in="models/shoe-violet-far.glb" position="0 0.98 0.25" rotation="0 200 0" />
