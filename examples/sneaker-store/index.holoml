    </group>
    <group load="near" near="7.5" position="5 0 -13" rotation="0 -90 0" shadows>
      <a href="shoe.holoml?colour=sky">
        <model id="shoe-sky-1" src="models/shoe-sky.glb" stand-in="models/shoe-sky-far.glb" position="-0.95 0.98 0.25" rotation="0 -20 0" />
        <model id="shoe-sky-2" src="models/shoe-sky.glb" stand-in="models/shoe-sky-far.glb" position="0 0.98 0.25" rotation="0 200 0" />
