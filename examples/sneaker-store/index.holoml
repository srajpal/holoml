<holoml version="0.2">
  <head>
    <title>Sneaker store</title>
    <meta name="description" content="A sneaker store to walk through: one shoe in ten colourways on its walls, each loaded as you come near. Open one to turn it over, choose its colour and size, and add it to your cart. A HoloML 0.2 shop." />
    <meta name="author" content="The HoloML Authors" />
    <script src="store.js" />
  </head>
  <!-- A bright hall, 26 m long, with five bays on each wall. Each bay's
       shoe is in a group that loads by area: it loads when the viewer
       comes within 7 m and is let go beyond 10.5 m, and a lighter
       stand-in shows in its place until then. -->
  <scene background="#f1efeb">
    <viewpoint id="entrance" mode="walk" position="0 1.6 -1.6" look-at="0 1.4 -12" label="Entrance" />
    <!-- prepare.mjs: the places and the shelves (made from colourways.js: edit there, and run tools/prepare.mjs) -->
    <viewpoint id="midnight" mode="walk" position="-1.9 1.6 -4" look-at="-5 1.45 -4" label="Midnight" />
    <viewpoint id="beach" mode="walk" position="-1.9 1.6 -8.5" look-at="-5 1.45 -8.5" label="Beach" />
    <viewpoint id="street" mode="walk" position="-1.9 1.6 -13" look-at="-5 1.45 -13" label="Street" />
    <viewpoint id="forest" mode="walk" position="-1.9 1.6 -17.5" look-at="-5 1.45 -17.5" label="Forest" />
    <viewpoint id="sunset" mode="walk" position="-1.9 1.6 -22" look-at="-5 1.45 -22" label="Sunset" />
    <viewpoint id="lemon" mode="walk" position="1.9 1.6 -4" look-at="5 1.45 -4" label="Lemon" />
    <viewpoint id="violet" mode="walk" position="1.9 1.6 -8.5" look-at="5 1.45 -8.5" label="Violet" />
    <viewpoint id="sky" mode="walk" position="1.9 1.6 -13" look-at="5 1.45 -13" label="Sky" />
    <viewpoint id="cloud" mode="walk" position="1.9 1.6 -17.5" look-at="5 1.45 -17.5" label="Cloud" />
    <viewpoint id="ember" mode="walk" position="1.9 1.6 -22" look-at="5 1.45 -22" label="Ember" />

    <group load="near" near="7.5" position="-5 0 -4" rotation="0 90 0" shadows>
      <a href="shoe.holoml?colour=midnight">
        <model id="shoe-midnight-1" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="-0.95 0.98 0.25" rotation="0 -20 0" />
        <model id="shoe-midnight-2" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="0 0.98 0.25" rotation="0 200 0" />
        <model id="shoe-midnight-3" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="0.95 0.98 0.25" rotation="0 -20 0" />
        <model id="shoe-midnight-4" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="-0.95 1.6 0.25" rotation="0 200 0" />
        <model id="shoe-midnight-5" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="0 1.6 0.25" rotation="0 -20 0" />
        <model id="shoe-midnight-6" src="models/shoe-midnight.glb" stand-in="models/shoe-midnight-far.glb" position="0.95 1.6 0.25" rotation="0 200 0" />
        <panel position="0 2.39 0.47" width="2.4" size="0.06" color="#1f2328" background="#fbfaf7">
          Midnight · $120

          Everyday Runner, blue knit, navy trim
        </panel>
      </a>
    </group>
    <group load="near" near="7.5" position="-5 0 -8.5" rotation="0 90 0" shadows>
      <a href="shoe.holoml?colour=beach">
        <model id="shoe-beach-1" src="models/shoe-beach.glb" stand-in="models/shoe-beach-far.glb" position="-0.95 0.98 0.25" rotation="0 -20 0" />
        <model id="shoe-beach-2" src="models/shoe-beach.glb" stand-in="models/shoe-beach-far.glb" position="0 0.98 0.25" rotation="0 200 0" />
