    <!-- end of prepare.mjs's places and shelves -->
    <viewpoint id="counter" mode="walk" position="0 1.6 -20.6" look-at="0 1.45 -24" label="Counter" />

    <!-- Light from above (the shoes' shadows fall on their cubbies' floors), and a soft light onto each wall's bays. -->
    <light type="ambient" intensity="0.7" />
    <light type="directional" position="0 14 -4" look-at="0 0 -13" intensity="1.2" color="#fffaf2" shadows />
    <light type="directional" position="6 3 -13" look-at="0 1.2 -13" intensity="0.45" color="#fff6ea" />
    <light type="directional" position="-6 3 -13" look-at="0 1.2 -13" intensity="0.45" color="#fff6ea" />

    <hud id="cart" corner="top-left" size="18" color="#1f2328">Cart: empty</hud>

    <a href="checkout.html">
      <panel position="0 0.62 -23.44" width="1.4" size="0.09" color="#ffffff" background="#1d6fa5">Checkout</panel>
    </a>
    <a href="about.holoml">
      <panel position="1.6 1.3 -6.15" rotation="-10 -18 0" width="0.7" size="0.06" color="#ffffff" background="#5b6472">About this store</panel>
    </a>
    <panel position="0 2.7 -25.88" width="6" size="0.2" color="#1f2328">
      Everyday Runner

      Ten colourways · EU sizes 36 to 47
    </panel>

    <group shadows>
      <model src="models/floor.glb" />
      <!-- prepare.mjs: the ledges -->
      <model src="models/ledge.glb" position="-5 0 -4" rotation="0 90 0" />
      <model src="models/ledge.glb" position="-5 0 -8.5" rotation="0 90 0" />
      <model src="models/ledge.glb" position="-5 0 -13" rotation="0 90 0" />
      <model src="models/ledge.glb" position="-5 0 -17.5" rotation="0 90 0" />
      <model src="models/ledge.glb" position="-5 0 -22" rotation="0 90 0" />
      <model src="models/ledge.glb" position="5 0 -4" rotation="0 -90 0" />
      <model src="models/ledge.glb" position="5 0 -8.5" rotation="0 -90 0" />
      <model src="models/ledge.glb" position="5 0 -13" rotation="0 -90 0" />
      <model src="models/ledge.glb" position="5 0 -17.5" rotation="0 -90 0" />
      <model src="models/ledge.glb" position="5 0 -22" rotation="0 -90 0" />
      <!-- end of the ledges -->
      <group solid>
        <model src="models/bench.glb" position="0 0 -13" />
        <model src="models/counter.glb" position="0 0 -23.9" />
        <model src="models/plant.glb" position="-4.2 0 -1.1" />
        <model src="models/plant.glb" position="4.2 0 -1.1" />
        <model src="models/plant.glb" position="-4.3 0 -25.2" />
        <model src="models/plant.glb" position="4.3 0 -25.2" />
        <model src="models/sign.glb" position="1.6 0 -6.2" />
      </group>
    </group>
    <model src="models/ceiling.glb" />
    <model src="models/entrance.glb" />
    <group solid>
      <model src="models/wall.glb" position="-5.1 0 -13" scale="0.2 4.2 26.4" />
      <model src="models/wall.glb" position="5.1 0 -13" scale="0.2 4.2 26.4" />
      <model src="models/wall.glb" position="0 0 -26.1" scale="10.4 4.2 0.2" />
      <model src="models/wall.glb" position="0 0 0.1" scale="10.4 4.2 0.2" />
      <!-- prepare.mjs: the bays -->
      <model src="models/bay.glb" position="-5 0 -4" rotation="0 90 0" />
      <model src="models/bay.glb" position="-5 0 -8.5" rotation="0 90 0" />
      <model src="models/bay.glb" position="-5 0 -13" rotation="0 90 0" />
      <model src="models/bay.glb" position="-5 0 -17.5" rotation="0 90 0" />
      <model src="models/bay.glb" position="-5 0 -22" rotation="0 90 0" />
      <model src="models/bay.glb" position="5 0 -4" rotation="0 -90 0" />
