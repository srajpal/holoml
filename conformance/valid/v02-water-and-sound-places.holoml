<holoml version="0.2">
  <head>
    <title>Water, and sounds from a place</title>
  </head>
  <scene background="#0b2a3a">
    <viewpoint position="0 1.6 6" mode="walk" />
    <water position="0 0 0" size="12 5 20" color="#1f6f8b" clarity="14" caustics />
    <model id="fish" src="models/fish.glb" position="0 2 0" animation="Swim" autoplay />
    <sound id="bubbles" src="sounds/bubbles.ogg" position="2 0.5 -3" range="12" loop autoplay />
    <group position="-3 0 0">
      <sound src="sounds/hum.ogg" position="0 1 0" volume="0.5" loop />
    </group>
  </scene>
</holoml>
