<holoml version="0.2">
  <scene id="sky" background="#87ceeb">
    <light id="sun" type="directional" position="10 20 0" intensity="1.2" color="#fff4d6" />
    <light id="lamp" type="point" position="0 2 0" intensity="0" />
    <animate target="#sun" attribute="position" from="10 20 0" to="-10 20 0" duration="60s" repeat="indefinite" />
    <animate target="#sun" attribute="intensity" from="1.2" to="0.1" duration="60s" />
    <animate target="#sun" attribute="color" from="#fff4d6" to="#ff9a5c" duration="60s" />
    <animate target="#lamp" attribute="intensity" to="1.5" duration="2s" />
    <animate target="#sky" attribute="background" from="#87ceeb" to="#0b1030" duration="60s" />
  </scene>
</holoml>
