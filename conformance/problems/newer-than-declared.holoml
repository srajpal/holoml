<holoml version="0.1">
  <head>
    <script src="game.js" />
  </head>
  <scene id="world">
    <sound src="pop.wav" />
    <hud>Score</hud>
    <viewpoint mode="walk" gravity speed="3" />
    <slider>Speed</slider>
    <choice><option>Day</option></choice>
    <light type="directional" shadows />
    <model id="m" src="m.glb" solid />
    <light id="sun" type="directional" />
    <animate target="#sun" attribute="intensity" to="0.5" duration="2s" />
  </scene>
</holoml>
