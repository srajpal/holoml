<holoml version="0.1">
  <scene>
    <group id="g" />
    <animate target="#g" attribute="position" to="0 1 0" duration="0s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="0.0ms" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1e-999s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="-1s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="+1s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1 s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="2S" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1sec" />
    <animate target="#g" attribute="position" to="0 1 0" duration="s" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1es" />
    <animate target="#g" attribute="position" to="0 1 0" duration="" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1s" repeat="1.5" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1s" repeat="1e3" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1s" repeat="-1" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1s" repeat="00" />
    <animate target="#g" attribute="position" to="0 1 0" duration="1s" repeat="Indefinite" />
  </scene>
</holoml>
