<label title="a < b">x</label>
<!--            ^ invalid.illegal.less-than-in-value.holoml
<!DOCTYPE holoml>
<!-- <----------------- invalid.illegal.unsupported-markup.holoml
<?xml version="1.0"?>
<!-- <----- invalid.illegal.unsupported-markup.holoml
</scene x>
